{
  "name": "nocturne",
  "version": "1.0.0",
  "private": true,
  "description": "Nocturne \u2014 on-device snore & breathing-pause monitor",
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "pull:night": "node scripts/pull-night.mjs",
    "replay": "node scripts/replay.mjs",
    "record:reference": "node scripts/record-reference.mjs",
    "prepare:android": "node scripts/prepare-android.mjs",
    "build:android": "node scripts/prepare-android.mjs && node scripts/gradle.mjs assembleDebug",
    "install:android": "node scripts/install-apk.mjs",
    "deploy": "node scripts/prepare-android.mjs && node scripts/gradle.mjs assembleDebug && node scripts/install-apk.mjs",
    "clean:android": "node scripts/gradle.mjs clean",
    "open:android": "cap open android",
    "sync": "cap sync android",
    "copy": "cap copy android"
  },
  "dependencies": {
    "@capacitor/android": "6.2.0",
    "@capacitor/core": "6.2.0",
    "@capacitor/preferences": "6.0.4",
    "@capacitor/filesystem": "6.0.4",
    "@capacitor/share": "6.0.4",
    "@capacitor/local-notifications": "6.1.3",
    "@mozartec/capacitor-microphone": "6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "6.2.0"
  }
}
